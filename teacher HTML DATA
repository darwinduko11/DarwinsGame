<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Online Teaching AI Assistant</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="topbar">
    <div>
      <p class="eyebrow">Online teaching assistant</p>
      <h1>AI Teaching Helper 🤖</h1>
      <p class="muted">Internet connection is required for this page.</p>
    </div>
    <a class="secondary-button" href="index.html">← Dashboard</a>
  </header>

  <main class="container">
    <section class="panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Ask for immediate help</p>
          <h2>Phonics, phonetics, grammar, reading, and writing</h2>
        </div>
        <span id="aiStatus" class="saved-message">Not connected</span>
      </div>

      <div class="task-form">
        <input id="apiKey" type="password" placeholder="Paste your OpenAI API key">
        <input id="model" value="gpt-4o-mini" placeholder="Model name">

        <div class="sound-grid">
          <button type="button" data-prompt="Create a phonics activity for the SH sound.">Phonics</button>
          <button type="button" data-prompt="Create five pronoun questions with answers.">Pronouns</button>
          <button type="button" data-prompt="Explain nouns, verbs, adjectives, and adverbs simply.">Grammar</button>
          <button type="button" data-prompt="Create a short beginner reading passage with three questions and answers.">Reading</button>
          <button type="button" data-prompt="Create a simple beginner writing exercise.">Writing</button>
        </div>

        <form id="aiForm" class="task-form">
          <input id="question" required placeholder="Ask the online AI a question">
          <button class="primary-button" type="submit">Ask online AI</button>
        </form>
      </div>

      <div id="answer" class="practice-box">
        Enter your API key and ask a question.
      </div>
    </section>
  </main>

  <script>
    const apiKey = document.getElementById("apiKey");
    const model = document.getElementById("model");
    const question = document.getElementById("question");
    const answer = document.getElementById("answer");
    const status = document.getElementById("aiStatus");

    apiKey.value = localStorage.getItem("aiApiKey") || "";

    apiKey.addEventListener("input", () => {
      localStorage.setItem("aiApiKey", apiKey.value.trim());
    });

    async function askAI(text) {
      if (!navigator.onLine) {
        throw new Error("No internet connection. Please connect to the internet.");
      }

      const key = apiKey.value.trim();

      if (!key) {
        throw new Error("Please enter an OpenAI API key.");
      }

      status.textContent = "Connecting...";
      answer.textContent = "The online AI is thinking...";

      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 30000);

      try {
        const response = await fetch("https://api.openai.com/v1/chat/completions", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": `Bearer ${key}`
          },
          body: JSON.stringify({
            model: model.value.trim() || "gpt-4o-mini",
            temperature: 0.4,
            messages: [
              {
                role: "system",
                content:
                  "You are a classroom-ready teaching assistant. " +
                  "Help with phonics, phonetics, pronunciation, pronouns, " +
                  "nouns, verbs, adjectives, adverbs, reading, writing, " +
                  "homework, and lesson activities. Use simple explanations."
              },
              {
                role: "user",
                content: text
              }
            ]
          }),
          signal: controller.signal
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data?.error?.message || `AI request failed: ${response.status}`
          );
        }

        const result = data?.choices?.[0]?.message?.content;

        if (!result) {
          throw new Error("The AI returned an empty response.");
        }

        status.textContent = "Online";
        answer.textContent = result;
      } catch (error) {
        status.textContent = "Error";

        if (error.name === "AbortError") {
          answer.textContent = "The request timed out. Please try again.";
        } else if (error.name === "TypeError") {
          answer.textContent =
            "The browser could not reach OpenAI. This may be a CORS, internet, or browser security problem.";
        } else {
          answer.textContent = error.message;
        }
      } finally {
        clearTimeout(timeout);
      }
    }

    document.getElementById("aiForm").addEventListener("submit", event => {
      event.preventDefault();

      const text = question.value.trim();
      if (text) askAI(text);
    });

    document.querySelectorAll("[data-prompt]").forEach(button => {
      button.addEventListener("click", () => {
        question.value = button.dataset.prompt;
        question.focus();
      });
    });
  </script>
</body>
</html>
